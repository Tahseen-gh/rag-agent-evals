# Copy to .env and fill as needed.
# Every variable below maps 1:1 to a field in fastapi_app/app/config.py:Settings
# (case-insensitive, no prefix) - if it's not a field there, Settings silently
# ignores it, so don't add vars here that don't correspond to one.

APP_NAME=domain-rag-evals-api
DEBUG=false

# Auth (unset both -> auth is a no-op; endpoints behind require_auth are open)
API_KEY=change-me
JWT_SECRET=change-me-jwt
JWT_ALGORITHM=HS256

# CORS - must be a JSON array, not a bare string
CORS_ORIGINS=["http://localhost:5173"]

# Protection
RATE_LIMIT_QPS=5.0
REQUEST_BODY_MAX_BYTES=100000
FUZZ_MODE=false

# Observability
METRICS_ENABLED=true
JSON_LOGS=true
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID

# Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HYBRID_ALPHA=0.5
USE_DUMMY_EMBEDDINGS=true
RAG_TOP_K=4

# Generation / agent (unset -> deterministic dummy client, no network needed)
# EVAL_ANTHROPIC_API_KEY takes priority over ANTHROPIC_API_KEY (useful in
# hosting environments that reserve the bare ANTHROPIC_API_KEY name for
# their own internal runtime auth - see fastapi_app/app/config.py). Set
# whichever one isn't reserved in your environment; a plain local .env file
# has no such collision, so either name works here.
EVAL_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
USE_DUMMY_LLM=true
AGENT_MAX_TURNS=6
